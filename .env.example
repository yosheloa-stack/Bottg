# ============================================================
#  BOTTG - Bot de Vendas Telegram (Free Fire) - Configuração
#  Copie este arquivo para .env e preencha os valores reais.
# ============================================================

# --- Telegram ---
BOT_TOKEN=123456:ABC-your-telegram-bot-token
# IDs (numéricos) dos administradores, separados por vírgula
ADMIN_IDS=123456789

# --- Identidade da loja ---
SHOP_NAME=Aurora System
SUPPORT_USERNAME=@seu_suporte
# Banner do menu (GIF/imagem). Caminho local ou URL https://
MENU_BANNER=assets/menu.gif

# --- Auto Like System API ---
# Base URL da API (padrão conforme documentação)
API_BASE_URL=https://fluxggx.squareweb.app
# Key da API principal (likes, info, skin, auto-like)
AUTOLIKE_API_KEY=sua-key-principal
# Key separada da API de Passe Booyah (gerada no /painel-passe)
PASSE_API_KEY=sua-key-de-passe
# Região padrão
DEFAULT_REGION=BR

# --- Mercado Pago ---
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxx
# Segredo do webhook (opcional, para validar assinatura x-signature)
MERCADOPAGO_WEBHOOK_SECRET=

# --- Servidor de Webhook (recebe notificações do Mercado Pago) ---
# URL pública onde o webhook está acessível (ex: https://seubot.com)
WEBHOOK_PUBLIC_URL=https://seudominio.com
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080

# --- Preços (em BRL) ---
PRICE_PASSE=19.90
PRICE_AUTOLIKE_30D=14.90

# --- Banco de dados ---
DB_PATH=data/bot.db
