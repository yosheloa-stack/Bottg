# ============================================================
#  BOTTG - Bot de Vendas Telegram (Free Fire) - Configuração
#  Copie este arquivo para .env e preencha os valores reais.
# ============================================================

# --- Telegram ---
BOT_TOKEN=123456:ABC-your-telegram-bot-token
# Donos configurados diretamente no código: 8204579375 e 8669377135

# --- Identidade da loja ---
SHOP_NAME=Aurora System
SUPPORT_USERNAME=@seu_suporte
# Banner do menu (GIF/imagem). Caminho local ou URL https://
MENU_BANNER=assets/menu.gif

# --- API antiga (consulta de jogador / skin / Auto-Like) ---
API_BASE_URL=https://fluxggx.squareweb.app
AUTOLIKE_API_KEY=sua-key-principal

# --- Likes Painel API (envio avulso de likes) ---
# Documentação: GET /api/like com header X-API-Key
LIKES_API_BASE_URL=https://likespainel.squareweb.app
LIKES_API_KEY=kpt_sua_api_key
# O /like pede 200 fixos à Likes Painel.
# O bot exibe como "enviados" somente o delta REAL do contador antes/depois.
# LIKES_QUANTITY não é mais usado para evitar configuração antiga sobrescrevendo o valor.

# --- Auto System (segunda alternativa de likes) ---
AUTOSYSTEM_BASE_URL=https://autolikesystem.com.br
# Chave iniciada por AUTOSYSTEM_. Se ficar vazia, o fallback fica desativado.
AUTOSYSTEM_API_KEY=

# --- Passe Booyah ---
PASSE_API_KEY=sua-key-de-passe

# --- FFHub Shop (produtos pagos / comando /like2) ---
FFHUB_BASE_URL=https://ffhub-shop.shardweb.app
FFHUB_API_KEY=

# Região padrão (usada pelas integrações antigas)
DEFAULT_REGION=BR

# --- Mercado Pago / PIX automático ---
# Gateway principal do bot.
# Use o Access Token de PRODUÇÃO. Também pode ser salvo pelo Painel Admin.
MERCADOPAGO_ACCESS_TOKEN=

# URL pública da aplicação na Square Cloud.
# O bot continua sendo Telegram; esta URL serve apenas ao health/webhook.
WEBHOOK_PUBLIC_URL=https://yosh7.squareweb.app
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080

# Opcional. Não confundir com Client Secret da aplicação.
MERCADOPAGO_WEBHOOK_SECRET=

# --- Preços (em BRL) ---
PRICE_PASSE=4.00
# Defina os preços dos pacotes Premium. Enquanto estiver 0.00, não ficam à venda.
PRICE_LIKE2_7D=0.00
PRICE_LIKE2_15D=0.00
PRICE_LIKE2_30D=0.00

# --- Banco de dados ---
DB_PATH=data/bot.db
