# ============================================================
#  BOTTG - Bot de Vendas Telegram (Free Fire) - Configuração
#  Copie este arquivo para .env e preencha os valores reais.
# ============================================================

# --- Telegram ---
BOT_TOKEN=123456:ABC-your-telegram-bot-token
# IDs (numéricos) dos administradores, separados por vírgula
ADMIN_IDS=8204579375

# --- Identidade da loja ---
SHOP_NAME=Aurora System
SUPPORT_USERNAME=@seu_suporte
# Banner do menu (GIF/imagem). Caminho local ou URL https://
MENU_BANNER=assets/menu.gif

# --- API antiga (consulta de jogador / skin / Auto-Like) ---
API_BASE_URL=https://fluxggx.squareweb.app
AUTOLIKE_API_KEY=sua-key-principal

# --- Likes Painel API (envio avulso de likes) ---
# Documentação: GET /api/like com header X-API-Key
LIKES_API_BASE_URL=http://likespainel.squareweb.app
LIKES_API_KEY=kpt_sua_api_key
# Quantidade solicitada por /like. A API aceita de 1 a 200,
# respeitando também o limite por requisição configurado na sua Key.
LIKES_QUANTITY=100

# --- Auto System (segunda alternativa de likes) ---
AUTOSYSTEM_BASE_URL=https://autolikesystem.com.br
# Chave iniciada por AUTOSYSTEM_. Se ficar vazia, o fallback fica desativado.
AUTOSYSTEM_API_KEY=

# --- Passe Booyah ---
PASSE_API_KEY=sua-key-de-passe

# --- FFHub Shop (produtos pagos / comando /like2) ---
FFHUB_BASE_URL=https://ffhub-shop.shardweb.app
FFHUB_API_KEY=

# Região padrão (usada pelas integrações antigas)
DEFAULT_REGION=BR

# --- Efí Bank / PIX automático ---
# Credenciais da aplicação Pix criadas no painel Efí.
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_PIX_KEY=
# Produção: false | Homologação: true
EFI_SANDBOX=false

# Certificado cliente da API Pix.
# Preferencial: converta o .p12 para um PEM contendo certificado + chave privada
# e coloque o conteúdo do PEM codificado em Base64 nesta variável.
EFI_CERT_PEM_BASE64=
# Alternativa: caminho local para um arquivo .pem já existente no servidor.
EFI_CERT_PATH=

# Token opcional para reforçar a validação do webhook.
EFI_WEBHOOK_TOKEN=

# O bot consulta automaticamente a Efí a cada poucos segundos, portanto
# WEBHOOK_PUBLIC_URL é opcional. Se definido, também tenta registrar webhook.
WEBHOOK_PUBLIC_URL=
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080

# --- Mercado Pago (legado / não utilizado como gateway principal) ---
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# --- Preços (em BRL) ---
PRICE_PASSE=4.00
PRICE_AUTOLIKE_30D=14.90

# --- Banco de dados ---
DB_PATH=data/bot.db
